{
  "name": "skins-manager",
  "version": "1.0.0",
  "private": true,
  "description": "App local de inventário e giro de itens de CS2",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:demo": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend:demo\" \"npm:dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm run build && npm run serve",
    "serve": "npm --prefix backend run start",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend:demo": "npm --prefix backend run dev:demo",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "catalog:snapshot": "npm --prefix backend run catalog:snapshot",
    "seed:dev": "npm --prefix backend run seed:dev",
    "desktop:install": "npm --prefix desktop install",
    "desktop:stage": "npm --prefix desktop run stage",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:release": "npm --prefix desktop run release",
    "version:set": "node scripts/setVersion.js",
    "desktop:dev": "npm --prefix desktop run dev",
    "test:desktop": "npm --prefix desktop test",
    "test:all": "npm test && npm run test:desktop"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
