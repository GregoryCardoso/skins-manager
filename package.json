{
  "name": "skins-manager",
  "version": "1.0.0",
  "private": true,
  "description": "App local de inventário e giro de itens de CS2",
  "scripts": {
    "start": "npm --prefix backend run start",
    "dev:backend": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "catalog:snapshot": "npm --prefix backend run catalog:snapshot",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "seed:dev": "npm --prefix backend run seed:dev",
    "dev:backend:demo": "npm --prefix backend run dev:demo"
  }
}
