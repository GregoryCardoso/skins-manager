PORT=3001
# Vazio = %APPDATA%\SkinsManager\inventory.sqlite (pasta de dados do app, também usada pelo start-app.bat)
DB_PATH=
# Lista separada por vírgula; vazio = http://localhost:3000 e http://127.0.0.1:3000
CORS_ORIGIN=
# Padrão do limite "agarrado acima de" (2 a 365 dias); o usuário altera na tela de Configurações
SLOW_ITEM_DAYS=21
