{
  "name": "skins-manager-backend",
  "version": "1.4.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "catalog:snapshot": "node scripts/buildCatalogSnapshot.js",
    "seed:dev": "node scripts/seedDev.js",
    "dev:demo": "nodemon scripts/startDevDb.js",
    "sim:csfloat": "node scripts/simulateCsfloat.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "maxWorkers": "50%",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
