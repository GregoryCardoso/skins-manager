{
  "name": "skins-manager-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Skins Manager em janela própria (Electron)",
  "author": "Gregory Cardoso",
  "main": "src/main.js",
  "scripts": {
    "stage": "node scripts/stageApp.js",
    "start": "electron .",
    "dev": "node scripts/stageApp.js && electron .",
    "dist": "node scripts/stageApp.js && electron-builder --win --x64 --publish never",
    "test": "jest",
    "postinstall": "node node_modules/electron/install.js",
    "release": "node scripts/release.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "electron": "44.11.5",
    "electron-builder": "26.18.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
